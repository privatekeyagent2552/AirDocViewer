<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Block cleartext HTTP; app is offline-first (url_launcher uses HTTPS only). -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
